# LLM (generation) - Groq (endpoint kompatibel OpenAI)
LLM_API_KEY=isi_api_key_groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Khusus model reasoning (gpt-oss): low | medium | high. Kosongkan untuk model lain.
LLM_REASONING_EFFORT=medium
LLM_TEMPERATURE=0.2
# Batas token jawaban, 0 = bawaan penyedia
LLM_MAX_TOKENS=0

# Embedding - Gemini
GEMINI_API_KEY=isi_api_key_gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Vector database - Qdrant Cloud
QDRANT_URL=https://xxxxxxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=isi_api_key_qdrant
QDRANT_COLLECTION=skripsi_knowledge_base

# Parameter retrieval
TOP_K=4
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

# LLM penilai untuk RAGAS: WAJIB berbeda dari model yang diuji
# JUDGE_MODEL=
# JUDGE_BASE_URL=
# JUDGE_API_KEY=

