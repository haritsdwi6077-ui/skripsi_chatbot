# LLM (generation) - Groq (endpoint kompatibel OpenAI)
LLM_API_KEY=isi_api_key_groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Khusus model reasoning (gpt-oss): low | medium | high. Kosongkan untuk model lain.
LLM_REASONING_EFFORT=medium
LLM_TEMPERATURE=0.2
# Batas token jawaban, 0 = bawaan penyedia
LLM_MAX_TOKENS=0

# Embedding - Jina AI (ambil key di https://jina.ai/embeddings)
JINA_API_KEY=isi_api_key_jina
EMBEDDING_MODEL=jina-embeddings-v5-text-small
EMBEDDING_DIM=768

# Vector database - Qdrant Cloud
QDRANT_URL=https://xxxxxxxx.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=isi_api_key_qdrant
QDRANT_COLLECTION=skripsi_knowledge_base

# Parameter retrieval
TOP_K=6
# Jumlah potongan untuk pertanyaan bertipe daftar ("apa saja", "sebutkan", ...)
TOP_K_DAFTAR=8
# Retrieval beragam (MMR). MMR_AKTIF=0 kembali ke top-k biasa.
MMR_AKTIF=1
RETRIEVAL_KANDIDAT=40
MMR_LAMBDA=0.75
MAKS_PER_SUMBER=2
# Keragaman topik (subfolder data_source); 0 = matikan
JENDELA_SKOR=0.05
CHUNK_SIZE=1200
CHUNK_OVERLAP=180

# Gaya jawaban mode RAG: 
GAYA_JAWABAN=standar
# Sembunyikan pilihan mode Dengan/Tanpa RAG di halaman web: 0
TAMPILKAN_MODE=1

# LLM penilai untuk RAGAS: WAJIB berbeda dari model yang diuji (scripts/evaluate.py
# berhenti bila sama). Llama 3.3 70B dan Llama 3.1 8B sudah dihentikan Groq untuk
# akun gratis sejak 16 Agustus 2026, jadi jangan dipakai.
# Contoh A, Gemini (API key gratis dari https://aistudio.google.com/apikey):
# JUDGE_MODEL=gemini-3.8-flash
# JUDGE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# JUDGE_API_KEY=isi_api_key_gemini
# Contoh B, Groq (API key sama dengan LLM_API_KEY):
# JUDGE_MODEL=openai/gpt-oss-20b
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_API_KEY=isi_api_key_groq
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=


# --- Aplikasi web (revisi seminar hasil) ---
# 1 = setiap pesan dipahami LLM dulu (bahasa sehari-hari, singkatan, salam); 0 = alur lama
PAHAMI_PERTANYAAN=1
# Temperature jawaban di aplikasi web; 0 = paling konsisten
LLM_TEMPERATURE_PERCAKAPAN=0
# 1 = tampilkan saran pertanyaan templat di bawah jawaban (bawaan 0)
TAMPILKAN_SARAN=0
# Alamat dasar PDF sumber rujukan agar bisa diklik (kosongkan untuk mematikan).
# Tautan resmi per dokumen bisa diisi di rag_core/data/tautan_sumber.csv
SUMBER_BASE_URL=https://cdn.jsdelivr.net/gh/haritsdwi6077-ui/skripsi_chatbot@main/data_source
# Seed tetap untuk LLM di aplikasi web (kosongkan untuk mematikan)
LLM_SEED=42
# Simpan jawaban kueri baku agar pertanyaan bermakna sama selalu dijawab sama (0 = mati).
# Sumber utama: rag_core/data/jawaban_baku.json (buat dengan scripts/buat_jawaban_baku.py)
SIMPAN_JAWABAN=1
# Naikkan (misalnya 2) setelah dokumen rujukan diubah agar jawaban lama tidak dipakai
CACHE_VERSI=2
# Jumlah potongan dokumen untuk pertanyaan cara mengendalikan/mencegah
TOP_K_PENGENDALIAN=8
# Opsional: Redis Upstash, dibagi semua server Vercel (integrasi Upstash di Vercel
# mengisi KV_REST_API_URL dan KV_REST_API_TOKEN secara otomatis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Lama jawaban disimpan di Redis, dalam detik (0 = selamanya)
SIMPAN_JAWABAN_DETIK=0
